# ProxFlow normally needs NO config file: add Proxmox hosts in the UI (they're saved to
# apps/server/data/connections.json). The variables below are optional.

# ── Headless setup (Docker/CI): define one connection via environment ──
# PVE_URL=https://pve.example.lan:8006
# PVE_NAME=homelab
# Either an API token …
# PVE_TOKEN_ID=root@pam!proxflow
# PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# … or a username/password:
# PVE_USERNAME=root@pam
# PVE_PASSWORD=secret
# TLS: pin the certificate fingerprint (preferred; shown in Proxmox → System → Certificates) …
# PVE_FINGERPRINT=AB:CD:EF:...
# … or skip verification entirely (not recommended):
# PVE_INSECURE_TLS=false

# ── Ports / paths ──
# API server port (the web dev server proxies /api here)
PORT=3001
# Mock Proxmox port (apps/mock-pve)
MOCK_PORT=8006
# Where connections.json lives
# PROXFLOW_DATA_DIR=./apps/server/data
